<Window x:Class="KaragoPublisher.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="News Publisher 1.2.0 — Χιώτικη Διαφάνεια" Width="980" Height="900" MinWidth="760" MinHeight="650" WindowStartupLocation="CenterScreen">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18" MaxWidth="1150">
    <TextBlock Text="News Publisher 1.2.0" FontSize="27" FontWeight="Bold"/>
    <TextBlock Text="Χιώτικη Διαφάνεια — Επικόλληση μία φορά → Προσχέδιο ή Δημοσίευση" Foreground="#555" Margin="0,2,0,12"/>
    <WrapPanel>
      <Button Content="📋 Επικόλληση" Click="Paste_Click"/>
      <Button Content="Έλεγχος πακέτου" Click="Parse_Click"/>
      <Button Content="⚙ Ρυθμίσεις σύνδεσης" Click="Settings_Click"/>
      <Button Content="📢 Διαφημίσεις" Click="Ads_Click"/>
      <Button Content="Καθαρισμός" Click="Clear_Click"/>
    </WrapPanel>
    <TextBlock x:Name="AdStatusText" Text="Διαφημίσεις: φόρτωση..." Foreground="#555" Margin="8,0,4,8" TextWrapping="Wrap"/>
    <TextBox x:Name="PackageBox" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" MinHeight="250" FontFamily="Consolas" FontSize="14" Margin="4"/>
    <Border BorderBrush="#CCC" BorderThickness="1" Padding="12" Margin="4"><StackPanel>
      <TextBlock x:Name="SiteText" Text="Site: —" FontSize="19" FontWeight="Bold"/>
      <TextBlock x:Name="SummaryText" Text="Δεν έχει γίνει έλεγχος ακόμη." TextWrapping="Wrap" Margin="0,5,0,0"/>
    </StackPanel></Border>

    <DockPanel Margin="4,12,4,4"><TextBlock Text="Συχνές κατηγορίες" FontSize="19" FontWeight="Bold" DockPanel.Dock="Left"/><Button Content="↻ Ανανέωση" Click="RefreshCategories_Click" DockPanel.Dock="Right"/></DockPanel>
    <TextBlock x:Name="CategoryStatus" Text="Οι πραγματικές κατηγορίες θα φορτωθούν μετά τον έλεγχο." Margin="6" TextWrapping="Wrap"/>
    <StackPanel x:Name="FrequentPanel" Margin="4"/>
    <Button x:Name="ShowAllButton" Content="Όλες οι κατηγορίες ▼" IsEnabled="False" Click="ShowAll_Click"/>
    <StackPanel x:Name="AllArea" Visibility="Collapsed">
      <TextBox x:Name="CategorySearch" MinHeight="38" Margin="4" TextChanged="CategorySearch_TextChanged" ToolTip="Αναζήτηση κατηγορίας..."/>
      <ScrollViewer MaxHeight="310" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="AllPanel" Margin="4"/></ScrollViewer>
    </StackPanel>

    <WrapPanel Margin="4,10,4,2"><Button Content="🖼 Επιλογή featured image" Click="ChooseImage_Click"/><TextBlock x:Name="ImageText" Text="Featured image: καμία" VerticalAlignment="Center" Margin="8"/></WrapPanel>
    <Border Background="#F1F5F9" Padding="12" Margin="4,10"><TextBlock x:Name="FinalCategoriesText" Text="Επιλεγμένες κατηγορίες: —" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/></Border>
    <TextBlock Text="Οι διαφημίσεις θα προστεθούν αυτόματα κατά την αποστολή: η πρώτη πριν από το άρθρο και όλες οι υπόλοιπες μετά."
               TextWrapping="Wrap" Foreground="#555" Margin="8,2,8,6" TextAlignment="Center"/>
    <WrapPanel HorizontalAlignment="Center">
      <Button x:Name="DraftButton" Content="💾 ΑΠΟΘΗΚΕΥΣΗ ΩΣ ΠΡΟΣΧΕΔΙΟ" IsEnabled="False" Click="Draft_Click" MinWidth="290"/>
      <Button x:Name="PublishButton" Content="🚀 ΔΗΜΟΣΙΕΥΣΗ ΤΩΡΑ" IsEnabled="False" Click="Publish_Click" MinWidth="250" Background="#A51C30" Foreground="White"/>
    </WrapPanel>
    <TextBlock x:Name="ResultText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="14" Margin="4,12" Padding="12" Background="#FAFAFA"/>
  </StackPanel></ScrollViewer>
</Window>
