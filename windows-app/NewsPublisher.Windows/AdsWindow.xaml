<Window x:Class="KaragoPublisher.Windows.AdsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Διαχείριση διαφημίσεων" Width="850" Height="700" MinWidth="720" MinHeight="590"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="Διαφημίσεις άρθρων" FontSize="25" FontWeight="Bold"/>
      <TextBlock Text="Η πρώτη της λίστας μπαίνει πριν από το άρθρο. Όλες οι υπόλοιπες μπαίνουν μετά το άρθρο. Δεν υπάρχει όριο πλήθους."
                 TextWrapping="Wrap" Foreground="#555" Margin="0,4,0,10"/>
      <WrapPanel>
        <RadioButton x:Name="SequentialRadio" Content="Σταθερή σειρά" GroupName="OrderMode" Margin="4" FontSize="16"/>
        <RadioButton x:Name="RandomRadio" Content="Τυχαία σειρά — όλες μία φορά" GroupName="OrderMode" Margin="18,4,4,4" FontSize="16"/>
      </WrapPanel>
    </StackPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <DockPanel Grid.Column="0">
        <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center" Margin="0,8,0,0">
          <Button Content="＋ Νέα" Click="New_Click"/>
          <Button Content="▲ Πάνω" Click="Up_Click"/>
          <Button Content="▼ Κάτω" Click="Down_Click"/>
          <Button Content="Διαγραφή" Click="Delete_Click"/>
        </WrapPanel>
        <ListBox x:Name="AdsList" SelectionChanged="AdsList_SelectionChanged" FontSize="15" DisplayMemberPath="Name"/>
      </DockPanel>

      <StackPanel Grid.Column="2">
        <TextBlock Text="Όνομα διαφήμισης" FontWeight="SemiBold"/>
        <TextBox x:Name="NameBox" MinHeight="38" Margin="0,4,0,12"/>
        <TextBlock Text="Κώδικας από τον Classic Editor" FontWeight="SemiBold"/>
        <TextBox x:Name="HtmlBox" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" MinHeight="260" FontFamily="Consolas" FontSize="14" Margin="0,4,0,8"/>
        <TextBlock Text="Ο κώδικας αποθηκεύεται τοπικά σε αυτόν τον υπολογιστή. Για αλλαγή εικόνας, αντικαταστήστε εδώ το σχετικό HTML."
                   TextWrapping="Wrap" Foreground="#555"/>
        <Button Content="Αποθήκευση διαφήμισης" Click="SaveItem_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/>
      </StackPanel>
    </Grid>

    <DockPanel Grid.Row="2" Margin="0,14,0,0">
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#555" TextWrapping="Wrap"/>
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
        <Button Content="Ακύρωση" IsCancel="True"/>
        <Button Content="Αποθήκευση και κλείσιμο" Click="SaveAndClose_Click" Background="#A51C30" Foreground="White"/>
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
