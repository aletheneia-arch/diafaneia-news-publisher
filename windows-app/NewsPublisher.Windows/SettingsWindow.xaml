<Window x:Class="KaragoPublisher.Windows.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ρυθμίσεις Connector — Διαφάνεια" Width="560" Height="500" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
  <ScrollViewer><StackPanel Margin="22">
    <TextBlock Text="ΧΙΩΤΙΚΗ ΔΙΑΦΑΝΕΙΑ" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
    <TextBlock Text="Site URL"/>
    <TextBox Text="https://diafaneia.eu" IsReadOnly="True" MinHeight="34" Margin="0,3,0,10" Background="#F3F4F6"/>
    <TextBlock Text="KARAGO Connector API Key"/>
    <PasswordBox x:Name="DiafaneiaKey" MinHeight="34" Margin="0,3,0,12"/>
    <TextBlock Text="Χρησιμοποίησε το ξεχωριστό κλειδί που δημιούργησες για αυτό το PC από WordPress → Ρυθμίσεις → KARAGO Diafaneia. Δεν χρειάζεται username ή Application Password."
               TextWrapping="Wrap" Foreground="#555"/>
    <TextBlock Text="Το κλειδί αποθηκεύεται στο Windows Credential Manager και δεν γράφεται σε αρχεία ή logs του προγράμματος."
               TextWrapping="Wrap" Foreground="#555" Margin="0,8,0,0"/>
    <WrapPanel Margin="0,18,0,0">
      <Button x:Name="SaveButton" Content="Αποθήκευση με ασφάλεια" Click="Save_Click" MinWidth="205"/>
      <Button x:Name="TestButton" Content="Έλεγχος σύνδεσης" Click="Test_Click" MinWidth="180"/>
    </WrapPanel>
    <Border Background="#F1F5F9" Padding="12" Margin="0,15,0,0">
      <TextBlock x:Name="ConnectionStatus" Text="Δεν έχει γίνει ακόμη έλεγχος σύνδεσης." TextWrapping="Wrap"/>
    </Border>
  </StackPanel></ScrollViewer>
</Window>
